<Page
    x:Class="RetroTel.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <!-- Chats and contacts as two pivot pages (peers the user switches between often), the command
         bar at the bottom of a phone screen with refresh, and settings in its "More" menu. -->
    <Page.Resources>
        <CollectionViewSource x:Name="ContactGroups" IsSourceGrouped="True" />
    </Page.Resources>
    <Page.BottomAppBar>
        <CommandBar x:Name="Bar">
            <AppBarButton x:Name="RefreshButton" Label="Refresh" Click="Refresh_Click">
                <AppBarButton.Icon><FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE72C;" /></AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Settings" Click="Settings_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <Pivot x:Name="Tabs" Title="RETROTEL">
            <PivotItem Header="Chats" Margin="0">
                <Grid>
                    <ListView x:Name="ChatsList" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Chat_Click"
                              ItemContainerStyle="{StaticResource RowContainer}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.RowSpan="2" Width="40" Height="40" VerticalAlignment="Top">
                                        <Ellipse Fill="{ThemeResource SystemControlBackgroundAccentBrush}" Visibility="{Binding AvatarInitialsVisibility}" />
                                        <TextBlock Text="{Binding AvatarInitials}" Foreground="White" Style="{StaticResource BaseTextBlockStyle}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding AvatarInitialsVisibility}" />
                                        <Ellipse Visibility="{Binding AvatarImageVisibility}">
                                            <Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill" /></Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE718;" FontSize="12" Margin="0,0,6,0"
                                                  Visibility="{Binding PinnedVisibility}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding FormattedDate}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastMessage}" Margin="12,0,0,0"
                                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                    <Border Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" MinWidth="20" Height="20" Padding="6,0"
                                            CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="{ThemeResource SystemControlBackgroundAccentBrush}" Visibility="{Binding UnreadVisibility}">
                                        <TextBlock Text="{Binding UnreadCount}" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="ChatsEmpty" Style="{StaticResource EmptyText}" Margin="12,8" Visibility="Collapsed"
                               Text="No chats yet." />
                </Grid>
            </PivotItem>

            <PivotItem Header="Contacts" Margin="0">
                <Grid>
                    <ListView x:Name="ContactsList" ItemsSource="{Binding Source={StaticResource ContactGroups}}"
                              IsItemClickEnabled="True" SelectionMode="None" ItemClick="Contact_Click"
                              ItemContainerStyle="{StaticResource RowContainer}">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Key}" Style="{StaticResource SubtitleTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="40" Height="40">
                                        <Ellipse Fill="{ThemeResource SystemControlBackgroundAccentBrush}" />
                                        <TextBlock Text="{Binding Initials}" Foreground="White" Style="{StaticResource BaseTextBlockStyle}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Phone}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="ContactsEmpty" Style="{StaticResource EmptyText}" Margin="12,8" Visibility="Collapsed"
                               Text="No contacts." />
                </Grid>
            </PivotItem>
        </Pivot>
        <!-- the busy line along the top, with what is happening -->
        <StackPanel VerticalAlignment="Top" IsHitTestVisible="False">
            <ProgressBar x:Name="Busy" IsIndeterminate="False" Visibility="Collapsed" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" Margin="12,4,12,0"
                   HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
    </Grid>
</Page>
