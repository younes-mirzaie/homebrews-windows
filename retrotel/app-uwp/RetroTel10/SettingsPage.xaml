<Page
    x:Class="RetroTel.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <!-- The signed-in account, sign out, and about with the licenses. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="SETTINGS" Style="{StaticResource BarTitle}" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,0,12,24" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="Account" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,8" />
                <TextBlock x:Name="NameText" Style="{StaticResource BodyTextBlockStyle}" />
                <TextBlock x:Name="PhoneText" Style="{StaticResource SecondaryText}" />
                <Button x:Name="SignOutButton" Content="Sign out" Margin="0,12,0,0" Click="SignOut_Click" />

                <TextBlock Text="About" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="VersionText" Style="{StaticResource BodyTextBlockStyle}" />
                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="A Telegram client that talks to Telegram's servers directly (MTProto 2.0). Your messages go only between this device and Telegram." />
                <HyperlinkButton Content="Source code on GitHub" NavigateUri="https://github.com/younes-mirzaie/homebrews-windows/tree/main/retrotel" Margin="0,8,0,0" />

                <TextBlock Text="Licenses" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Text="RetroTel is based on Amigram by tallfly, MIT License. Copyright (c) tallfly and RetroTel contributors.&#x0a;&#x0a;Uses the Bouncy Castle cryptography library, MIT License. Copyright (c) The Legion of the Bouncy Castle Inc.&#x0a;&#x0a;Telegram is a trademark of Telegram FZ-LLC. RetroTel is not made by Telegram." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
