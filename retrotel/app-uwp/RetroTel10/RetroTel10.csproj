    <Compile Include="..\..\app\MetroTelegram\TL\DialogsService.cs"><Link>Core\TL\DialogsService.cs</Link></Compile>
    <Compile Include="..\..\app\MetroTelegram\TL\MediaService.cs"><Link>Core\TL\MediaService.cs</Link></Compile>
    <Compile Include="..\..\app\MetroTelegram\TL\MediaUploadService.cs"><Link>Core\TL\MediaUploadService.cs</Link></Compile>
    <Compile Include="..\..\app\MetroTelegram\TL\MessagesServices.cs"><Link>Core\TL\MessagesServices.cs</Link></Compile>
    <Compile Include="..\..\app\MetroTelegram\TL\ProfileService.cs"><Link>Core\TL\ProfileService.cs</Link></Compile>
    <Compile Include="..\..\app\MetroTelegram\TL\TelegramRpcEngine.cs"><Link>Core\TL\TelegramRpcEngine.cs</Link></Compile>
    <Compile Include="..\..\app\MetroTelegram\TL\TlBinaryReader.cs"><Link>Core\TL\TlBinaryReader.cs</Link></Compile>
    <Compile Include="..\..\app\MetroTelegram\TL\TlBinaryWriter.cs"><Link>Core\TL\TlBinaryWriter.cs</Link></Compile>
    <Compile Include="..\..\app\MetroTelegram\TL\UpdatesService.cs"><Link>Core\TL\UpdatesService.cs</Link></Compile>
    <Compile Include="..\..\app\MetroTelegram\Transport\DataCenter.cs"><Link>Core\Transport\DataCenter.cs</Link></Compile>
    <Compile Include="..\..\app\MetroTelegram\Transport\ITcpTransport.cs"><Link>Core\Transport\ITcpTransport.cs</Link></Compile>
    <Compile Include="..\..\app\MetroTelegram\Transport\MtprotoTcpTransport.cs"><Link>Core\Transport\MtprotoTcpTransport.cs</Link></Compile>
    <Compile Include="..\..\app\MetroTelegram\ViewModels\ChatViewModel.cs"><Link>Core\ViewModels\ChatViewModel.cs</Link></Compile>
    <Compile Include="..\..\app\MetroTelegram\ViewModels\MainViewModel.cs"><Link>Core\ViewModels\MainViewModel.cs</Link></Compile>
    <Compile Include="..\..\app\MetroTelegram\ViewModels\ProfileViewModel.cs"><Link>Core\ViewModels\ProfileViewModel.cs</Link></Compile>
    <Compile Include="..\..\app\MetroTelegram\ViewModels\SettingsViewModel.cs"><Link>Core\ViewModels\SettingsViewModel.cs</Link></Compile>
  </ItemGroup>

  <!-- Windows 10 only -->
  <ItemGroup>
    <Compile Include="Core10\CrashLog.cs" />
    <Compile Include="Core10\IsolatedStorageSettings.cs" />
    <Compile Include="Core10\Ui.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="App.xaml.cs"><DependentUpon>App.xaml</DependentUpon></Compile>
    <Compile Include="SignInPage.xaml.cs"><DependentUpon>SignInPage.xaml</DependentUpon></Compile>
    <Compile Include="MainPage.xaml.cs"><DependentUpon>MainPage.xaml</DependentUpon></Compile>
    <Compile Include="ChatPage.xaml.cs"><DependentUpon>ChatPage.xaml</DependentUpon></Compile>
    <Compile Include="PhotoPage.xaml.cs"><DependentUpon>PhotoPage.xaml</DependentUpon></Compile>
    <Compile Include="SettingsPage.xaml.cs"><DependentUpon>SettingsPage.xaml</DependentUpon></Compile>
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></ApplicationDefinition>
    <Page Include="SignInPage.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
    <Page Include="MainPage.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
    <Page Include="ChatPage.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
    <Page Include="PhotoPage.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
    <Page Include="SettingsPage.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform">
      <Version>6.2.14</Version>
    </PackageReference>
    <PackageReference Include="Portable.BouncyCastle">
      <Version>1.8.1.3</Version>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup Condition=" '$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '15.0' ">
    <VisualStudioVersion>15.0</VisualStudioVersion>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
</Project>
