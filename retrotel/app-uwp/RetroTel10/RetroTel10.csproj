    <Compile Include="..\..\app\MetroTelegram\Crypto\Telegram2FaSrp.cs"><Link>Core\Crypto\Telegram2FaSrp.cs</Link></Compile>
    <Compile Include="..\..\app\MetroTelegram\Crypto\TelegramRsa.cs"><Link>Core\Crypto\TelegramRsa.cs</Link></Compile>
