<Page
    x:Class="RetroTel.SignInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <!-- Three steps on one page: phone number, the code Telegram sends, then the two-step
         verification password when the account has one. Next sits in the command bar, which
         stays above the keyboard on a phone. -->
    <Page.BottomAppBar>
        <CommandBar x:Name="Bar">
            <AppBarButton x:Name="NextButton" Label="Next" Click="Next_Click">
                <AppBarButton.Icon><FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE72A;" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="RETROTEL" Style="{StaticResource BarTitle}" />
        <ProgressBar x:Name="Busy" Grid.Row="1" IsIndeterminate="False" Visibility="Collapsed" Margin="0,0,0,4" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,8,12,24" MaxWidth="480" HorizontalAlignment="Left">
                <TextBlock x:Name="StepTitle" Text="Sign in to Telegram" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />
                <TextBlock x:Name="StepText" Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,24"
                           Text="Enter your phone number with the country code. Telegram will send you a code." />

                <TextBox x:Name="PhoneBox" Header="Phone number" PlaceholderText="+1 555 123 4567"
                         InputScope="TelephoneNumber" KeyDown="Box_KeyDown" />

                <TextBox x:Name="CodeBox" Header="Code" InputScope="Number" MaxLength="8"
                         KeyDown="Box_KeyDown" Visibility="Collapsed" />

                <PasswordBox x:Name="PasswordBox" Header="Password" KeyDown="Box_KeyDown" Visibility="Collapsed" />
                <TextBlock x:Name="HintText" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" Margin="0,16,0,0" TextWrapping="Wrap" />

                <HyperlinkButton x:Name="ChangeNumber" Content="Use another number" Margin="0,16,0,0"
                                 Click="ChangeNumber_Click" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
