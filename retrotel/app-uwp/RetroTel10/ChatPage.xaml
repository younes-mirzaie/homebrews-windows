<Page
    x:Class="RetroTel.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <!-- One chat: name and status in the 48 px top bar, messages as bubbles (yours on the right in
         the accent color), and the compose bar at the bottom with attach and send. Press and hold
         (or right-click) a message for reply, copy and delete. -->
    <Page.Resources>
        <Style x:Key="ComposeButton" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <StackPanel Margin="12,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource BaseTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
        </Grid>
        <ProgressBar x:Name="Busy" Grid.Row="1" IsIndeterminate="False" Visibility="Collapsed" />

        <ListView x:Name="MessagesList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="False"
                  ItemContainerStyle="{StaticResource BubbleContainer}" Padding="0,8,0,0">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="{Binding BubbleAlignment}" Margin="{Binding BubbleMargin}"
                          Background="{Binding BubbleBackground}" Padding="10,6,10,6" RightTapped="Message_RightTapped">
                        <StackPanel>
                            <TextBlock Text="{Binding AuthorName}" Visibility="{Binding AuthorVisibility}"
                                       Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                            <Border Visibility="{Binding ReplyVisibility}" BorderThickness="2,0,0,0" Padding="8,0,0,0" Margin="0,2,0,4"
                                    BorderBrush="{Binding BubbleForeground}" Opacity="0.8">
                                <StackPanel>
                                    <TextBlock Text="{Binding ReplyAuthor}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                               Foreground="{Binding BubbleForeground}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ReplyText}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{Binding BubbleForeground}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Image Source="{Binding PhotoImage}" Visibility="{Binding PhotoVisibility}" MaxHeight="240" MaxWidth="280"
                                   Stretch="Uniform" HorizontalAlignment="Left" Margin="0,2,0,4" Tapped="Photo_Tapped" />
                            <TextBlock Text="{Binding Text}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{Binding BubbleForeground}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0" Opacity="0.7">
                                <TextBlock Text="{Binding FormattedTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{Binding BubbleForeground}" />
                                <TextBlock Text="{Binding StatusIcon}" Visibility="{Binding StatusVisibility}" Margin="4,0,0,0"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{Binding BubbleForeground}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- the message being replied to -->
        <Grid x:Name="ReplyBar" Grid.Row="3" Visibility="Collapsed" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <Border BorderThickness="2,0,0,0" BorderBrush="{ThemeResource SystemControlForegroundAccentBrush}" Margin="12,8,0,8" Padding="8,0,0,0">
                <StackPanel>
                    <TextBlock x:Name="ReplyAuthorText" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemControlForegroundAccentBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ReplyMessageText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Button Grid.Column="1" Style="{StaticResource ComposeButton}" VerticalAlignment="Center" Click="CancelReply_Click"
                    ToolTipService.ToolTip="Cancel reply">
                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE711;" FontSize="16" />
            </Button>
        </Grid>

        <Grid Grid.Row="4" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <Button x:Name="AttachButton" Style="{StaticResource ComposeButton}" Click="Attach_Click" ToolTipService.ToolTip="Send a photo">
                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE723;" FontSize="20" />
            </Button>
            <TextBox x:Name="ComposeBox" Grid.Column="1" PlaceholderText="Type a message" AcceptsReturn="True" TextWrapping="Wrap"
                     MaxHeight="120" Margin="0,8" VerticalAlignment="Center" InputScope="Chat" TextChanged="ComposeBox_TextChanged" />
            <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource ComposeButton}" Click="Send_Click" ToolTipService.ToolTip="Send">
                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE724;" FontSize="20"
                          Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
            </Button>
        </Grid>
    </Grid>
</Page>
