# Throwaway Dovecot for rbmaild tests (run-tests.sh fills in @DIR@ and @USER@).
base_dir = @DIR@/run
state_dir = @DIR@/state
instance_name = rbtest
protocols = imap
listen = 127.0.0.1
log_path = @DIR@/dovecot.log
info_log_path = @DIR@/dovecot.log
ssl = yes
ssl_cert = <@DIR@/server.crt
ssl_key = <@DIR@/server.key
ssl_min_protocol = TLSv1.2
disable_plaintext_auth = yes
auth_mechanisms = plain login xoauth2
mail_location = maildir:@DIR@/mail/%u
first_valid_uid = 1
default_internal_user = @USER@
default_login_user = @USER@
default_internal_group = @USER@
service imap-login {
  inet_listener imap {
    address = 127.0.0.1
    port = 10143
  }
  inet_listener imaps {
    address = 127.0.0.1
    port = 10993
    ssl = yes
  }
}
service anvil {
  chroot =
}
service imap-login {
  chroot =
}
passdb {
  driver = oauth2
  mechanisms = xoauth2
  args = @DIR@/oauth2.conf
}
passdb {
  driver = passwd-file
  args = scheme=PLAIN username_format=%u @DIR@/users
}
userdb {
  driver = static
  args = uid=@USER@ gid=@USER@ home=@DIR@/mail/%u
}
namespace inbox {
  inbox = yes
  separator = /
  mailbox Sent {
    special_use = \Sent
    auto = subscribe
  }
  mailbox Trash {
    special_use = \Trash
    auto = subscribe
  }
  mailbox Drafts {
    special_use = \Drafts
    auto = subscribe
  }
  mailbox "Entwürfe alt" {
    auto = subscribe
  }
}
protocol imap {
  mail_max_userip_connections = 50
}
