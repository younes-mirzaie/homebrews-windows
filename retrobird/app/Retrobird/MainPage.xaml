<local:RbPage
    x:Class="Retrobird.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Retrobird"
    NavigationCacheMode="Required">
    <!-- The inbox: a pivot of three views of one list (all, unread, flagged), grouped by day.
         The title says which inbox it is; tap it to switch inboxes. -->
    <local:RbPage.Resources>
        <CollectionViewSource x:Key="AllSource" IsSourceGrouped="True"/>
        <CollectionViewSource x:Key="UnreadSource" IsSourceGrouped="True"/>
        <CollectionViewSource x:Key="FlaggedSource" IsSourceGrouped="True"/>
    </local:RbPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Pivot x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <Pivot.Title>
                <StackPanel Orientation="Horizontal" Background="Transparent" Tapped="Title_Tapped" local:Motion.Tilt="True">
                    <TextBlock x:Name="TitleText" Text="RETROBIRD" Style="{StaticResource TitleTextBlockStyle}"/>
                    <!-- a chevron says the title can be tapped when there's more than one inbox -->
                    <TextBlock x:Name="TitleChevron" Text="&#x25BE;" Style="{StaticResource TitleTextBlockStyle}"
                               Margin="8,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Pivot.Title>
            <PivotItem Header="all">
                <Grid>
                    <ListView x:Name="AllList" ItemsSource="{Binding Source={StaticResource AllSource}}"
                              ItemTemplate="{StaticResource RbMailItem}" ItemContainerStyle="{StaticResource RbStretchItem}"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="List_ItemClick"
                              SelectionChanged="List_SelectionChanged">
                        <ListView.GroupStyle>
                            <GroupStyle HidesIfEmpty="True" HeaderTemplate="{StaticResource RbDayHeader}"/>
                        </ListView.GroupStyle>
                        <ListView.Footer>
                            <Button x:Name="MoreButton" Content="load older messages" Style="{StaticResource RbButton}"
                                    Click="MoreButton_Click" Visibility="Collapsed" Margin="0,0,0,19"/>
                        </ListView.Footer>
                    </ListView>
                    <TextBlock x:Name="AllEmpty" Text="No mail here." Visibility="Collapsed" FontSize="25.6" FontWeight="SemiLight"
                               Foreground="{ThemeResource RbSubtleBrush}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                </Grid>
            </PivotItem>
            <PivotItem Header="unread">
                <Grid>
                    <ListView x:Name="UnreadList" ItemsSource="{Binding Source={StaticResource UnreadSource}}"
                              ItemTemplate="{StaticResource RbMailItem}" ItemContainerStyle="{StaticResource RbStretchItem}"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="List_ItemClick"
                              SelectionChanged="List_SelectionChanged">
                        <ListView.GroupStyle>
                            <GroupStyle HidesIfEmpty="True" HeaderTemplate="{StaticResource RbDayHeader}"/>
                        </ListView.GroupStyle>
                    </ListView>
                    <TextBlock x:Name="UnreadEmpty" Text="You're all caught up." Visibility="Collapsed" FontSize="25.6" FontWeight="SemiLight"
                               Foreground="{ThemeResource RbSubtleBrush}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                </Grid>
            </PivotItem>
            <PivotItem Header="flagged">
                <Grid>
                    <ListView x:Name="FlaggedList" ItemsSource="{Binding Source={StaticResource FlaggedSource}}"
                              ItemTemplate="{StaticResource RbMailItem}" ItemContainerStyle="{StaticResource RbStretchItem}"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="List_ItemClick"
                              SelectionChanged="List_SelectionChanged">
                        <ListView.GroupStyle>
                            <GroupStyle HidesIfEmpty="True" HeaderTemplate="{StaticResource RbDayHeader}"/>
                        </ListView.GroupStyle>
                    </ListView>
                    <TextBlock x:Name="FlaggedEmpty" Text="Flag mail to keep it here." Visibility="Collapsed" FontSize="25.6" FontWeight="SemiLight"
                               Foreground="{ThemeResource RbSubtleBrush}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                </Grid>
            </PivotItem>
        </Pivot>

        <!-- the engine couldn't start: say so plainly, with a way to try again -->
        <StackPanel x:Name="ProblemPanel" Margin="19,120,19,0" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <TextBlock x:Name="ProblemText" FontSize="20.27" TextWrapping="Wrap"/>
            <Button Content="try again" Style="{StaticResource RbButton}" Margin="0,12,0,0" Click="RetryButton_Click"/>
        </StackPanel>

        <!-- a problem with an account or the connection: a band above the app bar; tap it to fix -->
        <Border x:Name="StatusBand" Grid.Row="1" Background="{ThemeResource RbChromeBrush}" Visibility="Collapsed"
                Tapped="StatusBand_Tapped" local:Motion.Tilt="True">
            <TextBlock x:Name="StatusText" Margin="19,8,19,9.5" Style="{StaticResource RbSmall}"
                       Foreground="{ThemeResource PhoneForegroundBrush}"/>
        </Border>
    </Grid>
</local:RbPage>
