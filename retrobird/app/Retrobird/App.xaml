<Application
    x:Class="Retrobird.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Metro on Windows Phone 8.1 (WinRT). Sizes are view pixels: the Silverlight value x 0.8
         (metro-ui-design skill, "Units"). The theme and accent are the user's; the stock controls
         bring tilt, the turnstile and the pivot motion. Silverlight ramp x 0.8: Small 14.93,
         Normal 16, Medium 18.13, MediumLarge 20.27, Large 25.6, ExtraLarge 34.13. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="RbSubtleBrush" Color="#99FFFFFF"/>
                    <SolidColorBrush x:Key="RbLineBrush" Color="#33FFFFFF"/>
                    <SolidColorBrush x:Key="RbChromeBrush" Color="#FF1F1F1F"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="RbSubtleBrush" Color="#99000000"/>
                    <SolidColorBrush x:Key="RbLineBrush" Color="#33000000"/>
                    <SolidColorBrush x:Key="RbChromeBrush" Color="#FFDDDDDD"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- page header, as the Windows Phone 8.1 page template and the system apps lay it out:
                 app title in caps, page title lowercase and huge -->
            <Style x:Key="RbHeaderPanel" TargetType="StackPanel">
                <Setter Property="Margin" Value="19,0,0,0"/>
            </Style>
            <Style x:Key="RbAppTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,12,0,0"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="RbPageTitle" TargetType="TextBlock" BasedOn="{StaticResource HeaderTextBlockStyle}">
                <Setter Property="Margin" Value="0,-6.5,0,24"/>
                <Setter Property="CharacterSpacing" Value="{ThemeResource PivotHeaderItemCharacterSpacing}"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>

            <Style x:Key="RbBody" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="LineHeight" Value="21"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="RbSubtle" TargetType="TextBlock" BasedOn="{StaticResource RbBody}">
                <Setter Property="Foreground" Value="{ThemeResource RbSubtleBrush}"/>
            </Style>
            <Style x:Key="RbSmall" TargetType="TextBlock" BasedOn="{StaticResource RbSubtle}">
                <Setter Property="FontSize" Value="14.93"/>
                <Setter Property="LineHeight" Value="19"/>
            </Style>
            <!-- list group headers ("today", "gmail"): lowercase, accent, Large Semilight -->
            <Style x:Key="RbGroupHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="25.6"/>
                <Setter Property="FontWeight" Value="SemiLight"/>
                <Setter Property="Foreground" Value="{ThemeResource PhoneAccentBrush}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <!-- list primary line: ExtraLarge Semilight (34 view px) for short lists, Large (25.6) for mail -->
            <Style x:Key="RbItemTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="25.6"/>
                <Setter Property="FontWeight" Value="SemiLight"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>
            <Style x:Key="RbItemTitleLarge" TargetType="TextBlock" BasedOn="{StaticResource RbItemTitle}">
                <Setter Property="FontSize" Value="34.13"/>
            </Style>
            <!-- a caption above a control (text box, picker, switch) -->
            <Style x:Key="RbCaption" TargetType="TextBlock" BasedOn="{StaticResource RbSubtle}">
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="RbButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
            <Style x:Key="RbLink" TargetType="HyperlinkButton">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Padding" Value="0,4"/>
                <Setter Property="Foreground" Value="{ThemeResource PhoneAccentBrush}"/>
            </Style>

            <!-- list rows stretch so a count or a time can sit at the right edge; the stock
                 container keeps the tilt -->
            <Style x:Key="RbStretchItem" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>

            <!-- one message in a list: sender (Semilight, Regular when unread) and time, then the
                 subject (accent when unread) with attachment, replied and flag marks -->
            <DataTemplate x:Key="RbMailItem">
                <StackPanel Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Sender}" FontWeight="{Binding SenderWeight}" Style="{StaticResource RbItemTitle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource RbSmall}" TextWrapping="NoWrap"
                                   VerticalAlignment="Bottom" Margin="9.5,0,0,3"/>
                    </Grid>
                    <Grid Margin="0,-2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SubjectText}" Visibility="{Binding UnreadVisibility}" FontSize="16" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource PhoneAccentBrush}"/>
                        <TextBlock Text="{Binding SubjectText}" Visibility="{Binding ReadVisibility}" FontSize="16" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="&#xE16C;" FontFamily="Segoe UI Symbol" FontSize="14.93" Margin="6,0,0,0"
                                   Foreground="{ThemeResource RbSubtleBrush}" Visibility="{Binding AttachmentVisibility}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="&#xE172;" FontFamily="Segoe UI Symbol" FontSize="14.93" Margin="6,0,0,0"
                                   Foreground="{ThemeResource RbSubtleBrush}" Visibility="{Binding RepliedVisibility}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="&#xE129;" FontFamily="Segoe UI Symbol" FontSize="14.93" Margin="6,0,0,0"
                                   Foreground="{ThemeResource PhoneAccentBrush}" Visibility="{Binding FlagVisibility}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{Binding AccountLabel}" Visibility="{Binding AccountVisibility}" Margin="8,0,0,0"
                                   Style="{StaticResource RbSmall}" TextWrapping="NoWrap" MaxWidth="96" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding Preview}" Visibility="{Binding PreviewVisibility}" FontSize="16" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource RbSubtleBrush}"/>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="RbDayHeader">
                <TextBlock Text="{Binding Key}" Style="{StaticResource RbGroupHeader}"/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
