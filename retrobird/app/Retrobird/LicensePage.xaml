<local:RbPage
    x:Class="Retrobird.LicensePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Retrobird">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Style="{StaticResource RbHeaderPanel}">
            <TextBlock Text="RETROBIRD" Style="{StaticResource RbAppTitle}"/>
            <TextBlock Text="licenses" Style="{StaticResource RbPageTitle}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <!-- one TextBlock per paragraph keeps long texts fast to lay out -->
            <StackPanel x:Name="Paragraphs" Margin="19,0,19,19"/>
        </ScrollViewer>
    </Grid>
</local:RbPage>
