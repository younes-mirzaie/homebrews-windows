    <Content Include="Assets\Square71x71Logo.scale-240.png" />
    <Content Include="Assets\Square44x44Logo.scale-240.png" />
    <Content Include="Assets\StoreLogo.scale-240.png" />
    <Content Include="Assets\SplashScreen.scale-240.png" />
    <!-- shown on the licenses page: credit and MPL 2.0 text for Mozilla's NSPR/NSS -->
    <Content Include="Legal\NOTICES.txt" />
    <Content Include="Legal\MPL-2.0.txt" />
    <Content Include="Legal\uxp-nss-nspr-changes.patch" />
    <!-- the in-app mail engine (rbmail.dll) and its NSS/NSPR DLLs, put in Helper\ by ..\..\build.ps1
         and packaged at the root, where DllImport("rbmail.dll") and the DLL search find them -->
    <Content Include="Helper\rbmail.dll"><Link>rbmail.dll</Link></Content>
    <Content Include="Helper\nssckbi.dll"><Link>nssckbi.dll</Link></Content>
    <Content Include="Helper\nspr4.dll"><Link>nspr4.dll</Link></Content>
    <Content Include="Helper\plc4.dll"><Link>plc4.dll</Link></Content>
    <Content Include="Helper\plds4.dll"><Link>plds4.dll</Link></Content>
  </ItemGroup>
  <PropertyGroup Condition=" '$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '12.0' ">
    <VisualStudioVersion>12.0</VisualStudioVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetPlatformIdentifier)' == '' ">
    <TargetPlatformIdentifier>WindowsPhoneApp</TargetPlatformIdentifier>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
</Project>
