    <Compile Include="MessagePage.xaml.cs"><DependentUpon>MessagePage.xaml</DependentUpon></Compile>
    <Compile Include="ComposePage.xaml.cs"><DependentUpon>ComposePage.xaml</DependentUpon></Compile>
    <Compile Include="FoldersPage.xaml.cs"><DependentUpon>FoldersPage.xaml</DependentUpon></Compile>
