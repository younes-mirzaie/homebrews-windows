<local:RbPage
    x:Class="Retrobird.FoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Retrobird">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Style="{StaticResource RbHeaderPanel}">
            <TextBlock x:Name="AccountText" Text="RETROBIRD" Style="{StaticResource RbAppTitle}"/>
            <TextBlock x:Name="TitleText" Text="folders" Style="{StaticResource RbPageTitle}"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="19,0,19,9.5" Visibility="Collapsed" Style="{StaticResource RbSmall}"/>
        <ListView x:Name="Items" Grid.Row="2" Padding="19,0,19,0" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="Items_ItemClick" ItemContainerStyle="{StaticResource RbStretchItem}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,9.5" Opacity="{Binding ItemOpacity}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource RbItemTitleLarge}"/>
                        <!-- unread count in the accent color -->
                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{ThemeResource PhoneAccentBrush}"
                                   Style="{StaticResource RbItemTitleLarge}" Margin="10,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</local:RbPage>
