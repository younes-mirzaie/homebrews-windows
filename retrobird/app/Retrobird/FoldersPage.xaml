<local:RbPage
    x:Class="Retrobird.FoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Retrobird">
    <!-- Folders with unread counts, grouped by account. In pick mode ("move") only the current
         account's folders, to move a message to. -->
    <local:RbPage.Resources>
        <CollectionViewSource x:Key="FolderSource" IsSourceGrouped="True"/>
    </local:RbPage.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Style="{StaticResource RbHeaderPanel}">
            <TextBlock x:Name="AccountText" Text="RETROBIRD" Style="{StaticResource RbAppTitle}"/>
            <TextBlock x:Name="TitleText" Text="folders" Style="{StaticResource RbPageTitle}"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="19,0,19,9.5" Visibility="Collapsed" Style="{StaticResource RbSmall}"/>
        <ListView x:Name="Items" Grid.Row="2" Padding="19,0,19,0" SelectionMode="None" IsItemClickEnabled="True"
                  ItemsSource="{Binding Source={StaticResource FolderSource}}"
                  ItemClick="Items_ItemClick" ItemContainerStyle="{StaticResource RbStretchItem}">
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Key}" Style="{StaticResource RbGroupHeader}" Margin="0,9.5,0,4"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,7" Opacity="{Binding Folder.ItemOpacity}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Folder.Label}" Style="{StaticResource RbItemTitleLarge}"/>
                        <!-- unread count in the accent color -->
                        <TextBlock Grid.Column="1" Text="{Binding Folder.CountText}" Foreground="{ThemeResource PhoneAccentBrush}"
                                   Style="{StaticResource RbItemTitle}" VerticalAlignment="Center" Margin="9.5,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</local:RbPage>
