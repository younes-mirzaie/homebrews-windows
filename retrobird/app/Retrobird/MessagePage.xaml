<local:RbPage
    x:Class="Retrobird.MessagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Retrobird">
    <!-- One message: where it is, who it's from (large), the subject in the accent color, who it
         went to (tap for every address), attachments, then the body. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel x:Name="HeaderPanel" Margin="19,0,19,0">
            <TextBlock x:Name="WhereText" Style="{StaticResource RbAppTitle}"/>
            <TextBlock x:Name="FromText" FontSize="34.13" FontWeight="SemiLight" TextTrimming="CharacterEllipsis"
                       Margin="0,8,0,0" CharacterSpacing="-10"/>
            <TextBlock x:Name="SubjectText" FontSize="25.6" FontWeight="SemiLight" TextWrapping="Wrap" MaxHeight="92"
                       Foreground="{ThemeResource PhoneAccentBrush}" Margin="0,-2,0,0"/>
            <!-- tap for every address -->
            <TextBlock x:Name="WhenText" Style="{StaticResource RbSmall}" Margin="0,6,0,0" Tapped="Header_Tapped"
                       local:Motion.Tilt="True"/>
            <TextBlock x:Name="DetailsText" Visibility="Collapsed" Margin="0,6,0,0" Style="{StaticResource RbSmall}"
                       IsTextSelectionEnabled="True"/>
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="0,12,0,0" FontSize="20.27" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel x:Name="ExtrasPanel" Grid.Row="1" Margin="19,12,19,0">
            <!-- attachments: a short list, each with its type in an accent square -->
            <ListView x:Name="Attachments" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="Attachments_ItemClick" MaxHeight="124">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,9.5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38.5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38.5" Height="38.5" Background="{ThemeResource PhoneAccentBrush}" VerticalAlignment="Top">
                                <TextBlock Text="&#xE16C;" FontFamily="Segoe UI Symbol" FontSize="18" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9.5,-3,0,0">
                                <TextBlock Text="{Binding Name}" FontSize="18.13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource RbSmall}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <!-- remote pictures are blocked until asked for -->
            <Grid x:Name="PicturesBand" Visibility="Collapsed" Margin="0,0,0,9.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" BorderBrush="{ThemeResource RbLineBrush}" BorderThickness="0,1,0,1"/>
                <TextBlock Text="Pictures from the web are hidden." Style="{StaticResource RbSmall}" VerticalAlignment="Center" Margin="0,8"/>
                <HyperlinkButton Grid.Column="1" Content="show pictures" Style="{StaticResource RbLink}" FontSize="14.93"
                                 Click="ImagesButton_Click"/>
            </Grid>
        </StackPanel>
        <!-- the mail engine has already removed the mail's own scripts; the page's one script only says
             when the reader scrolls, so the headers above slide away and come back -->
        <WebView x:Name="Body" Grid.Row="2" Opacity="0" Margin="0,4,0,0"
                 NavigationStarting="Body_NavigationStarting" NavigationCompleted="Body_NavigationCompleted"
                 ScriptNotify="Body_ScriptNotify"/>
    </Grid>
</local:RbPage>
