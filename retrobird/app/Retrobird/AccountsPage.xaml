<phone:PhoneApplicationPage
    x:Class="Retrobird.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="12,8,12,8">
            <TextBlock Text="RETROBIRD" Style="{StaticResource PhoneTextNormalStyle}" Margin="12,0"/>
            <TextBlock Text="accounts" Margin="9,-7,12,0"
                       FontSize="{StaticResource PhoneFontSizeExtraExtraLarge}" FontFamily="{StaticResource PhoneFontFamilySemiLight}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="12,0,12,0">
            <StackPanel>
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,4,0,12" Background="Transparent" Tap="Account_Tap" Tag="{Binding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource PhoneFontSizeLarge}"
                                               FontFamily="{StaticResource PhoneFontFamilySemiLight}" TextTrimming="WordEllipsis"/>
                                    <TextBlock Text="{Binding SubText}" TextWrapping="Wrap" MaxHeight="60"
                                               Foreground="{StaticResource PhoneSubtleBrush}" FontSize="{StaticResource PhoneFontSizeSmall}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="edit" Tap="Edit_Tap" Tag="{Binding}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="add account" HorizontalAlignment="Left" Click="Add_Click"/>

                <TextBlock Text="settings" Margin="12,24,12,0" FontSize="{StaticResource PhoneFontSizeLarge}"
                           FontFamily="{StaticResource PhoneFontFamilySemiLight}"/>
                <TextBlock Text="check the inbox in the background" Style="{StaticResource PhoneTextSubtleStyle}" Margin="12,8,12,0"/>
                <Button x:Name="SyncButton" HorizontalAlignment="Left" Click="SyncButton_Click"/>
                <CheckBox x:Name="ImagesBox" Content="show pictures from the web in mail" Checked="ImagesBox_Changed" Unchecked="ImagesBox_Changed"/>
                <TextBlock x:Name="AboutText" TextWrapping="Wrap" Margin="12,24,12,24"
                           Foreground="{StaticResource PhoneSubtleBrush}" FontSize="{StaticResource PhoneFontSizeSmall}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</phone:PhoneApplicationPage>
