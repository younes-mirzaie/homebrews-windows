<local:RbPage
    x:Class="Retrobird.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Retrobird">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Style="{StaticResource RbHeaderPanel}">
            <TextBlock Text="RETROBIRD" Style="{StaticResource RbAppTitle}"/>
            <TextBlock Text="settings" Style="{StaticResource RbPageTitle}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="19,0,19,19">
                <TextBlock Text="accounts" Style="{StaticResource RbSection}" Margin="0,0,0,9.5"/>
                <!-- tap an account to show its mail; "edit" changes it -->
                <ListView x:Name="Items" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Items_ItemClick"
                          ItemContainerStyle="{StaticResource RbStretchItem}" ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource RbItemTitle}"/>
                                    <TextBlock Text="{Binding SubText}" Style="{StaticResource RbSmall}" MaxHeight="48"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="edit" Click="Edit_Click" Tag="{Binding}" VerticalAlignment="Center"
                                        Margin="10,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Content="add account" Style="{StaticResource RbButton}" Click="Add_Click"/>

                <TextBlock Text="check for new mail" Style="{StaticResource RbSection}"/>
                <TextBlock Text="while Retrobird is open" Style="{StaticResource RbSubtle}" Margin="0,4,0,0"/>
                <Button x:Name="SyncButton" Style="{StaticResource RbButton}" Click="SyncButton_Click"/>
                <TextBlock Text="while Retrobird is closed" Style="{StaticResource RbSubtle}" Margin="0,4,0,0"/>
                <Button x:Name="BackgroundButton" Style="{StaticResource RbButton}" Click="BackgroundButton_Click"/>
                <TextBlock Style="{StaticResource RbSmall}"
                           Text="Windows Phone decides when to run the check, so new mail can take up to about half an hour to show up on the tile. It works on the phone alone: there's no push service."/>
                <ToggleSwitch x:Name="NotifySwitch" Header="notifications for new mail" Toggled="NotifySwitch_Toggled" Margin="0,9.5,0,0"/>

                <TextBlock Text="pictures" Style="{StaticResource RbSection}"/>
                <ToggleSwitch x:Name="ImagesSwitch" Header="show pictures from the web in mail" Toggled="ImagesSwitch_Toggled"/>

                <TextBlock Text="about" Style="{StaticResource RbSection}"/>
                <TextBlock x:Name="AboutText" Style="{StaticResource RbSmall}" Margin="0,4,0,0"/>
                <TextBlock Style="{StaticResource RbSmall}" Margin="0,9.5,0,0"
                           Text="Retrobird is built on Mozilla's NSPR and NSS libraries (the networking and encryption Firefox uses), used under the Mozilla Public License 2.0. Retrobird is an independent project, not made, endorsed or supported by Mozilla."/>
                <Button Content="licenses and source" Style="{StaticResource RbButton}" Click="LicensesButton_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:RbPage>
