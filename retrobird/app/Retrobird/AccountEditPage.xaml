<local:RbPage
    x:Class="Retrobird.AccountEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Retrobird">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Style="{StaticResource RbHeaderPanel}">
            <TextBlock Text="RETROBIRD" Style="{StaticResource RbAppTitle}"/>
            <TextBlock x:Name="TitleText" Text="add account" Style="{StaticResource RbPageTitle}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="19,0,19,19">
                <TextBox x:Name="EmailBox" Header="email address" InputScope="EmailSmtpAddress" TextChanged="EmailBox_TextChanged"/>
                <PasswordBox x:Name="PassBox" Header="password"/>
                <TextBlock x:Name="PassHint" Text="Leave it empty to keep the saved password." Visibility="Collapsed"
                           Style="{StaticResource RbSmall}" Margin="0,-4,0,9.5"/>
                <TextBox x:Name="NameBox" Header="your name (people you write to see it)" InputScope="PersonalFullName"/>

                <!-- app password advice: the phone platform is old, so a password you can cancel is safer -->
                <StackPanel x:Name="AdvicePanel" Margin="0,4,0,9.5">
                    <TextBlock x:Name="ProviderText" Visibility="Collapsed" Margin="0,0,0,4"
                               Foreground="{ThemeResource PhoneAccentBrush}" FontSize="20.27"/>
                    <TextBlock x:Name="NoteText" Style="{StaticResource RbBody}" Visibility="Collapsed" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource RbSmall}"
                               Text="Use an app password, not your main password. Windows Phone is an older system that no longer gets security updates. An app password works only for mail, and you can cancel it from your account at any time without changing your main password."/>
                    <Button x:Name="AppPasswordButton" Content="get an app password" Style="{StaticResource RbButton}"
                            Visibility="Collapsed" Click="AppPasswordButton_Click"/>
                </StackPanel>
                <CheckBox x:Name="SaveSentBox" Content="keep a copy of sent mail in Sent" IsChecked="True"/>
                <Button x:Name="AdvancedButton" Content="server settings" Style="{StaticResource RbButton}" Click="AdvancedButton_Click"/>

                <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                    <TextBlock Text="incoming mail (IMAP)" Style="{StaticResource RbSection}" Margin="0,9.5,0,4"/>
                    <TextBox x:Name="ImapHostBox" Header="server" InputScope="Url" TextChanged="Server_Changed"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ImapPortBox" Header="port" InputScope="Number" TextChanged="Server_Changed"/>
                        <ComboBox x:Name="ImapSecBox" Grid.Column="1" Header="security" Margin="12,0,0,0" SelectionChanged="Sec_Changed"/>
                    </Grid>
                    <TextBox x:Name="UserBox" Header="user name" InputScope="EmailSmtpAddress" TextChanged="Server_Changed"/>

                    <TextBlock Text="outgoing mail (SMTP)" Style="{StaticResource RbSection}" Margin="0,9.5,0,4"/>
                    <TextBox x:Name="SmtpHostBox" Header="server" InputScope="Url" TextChanged="Server_Changed"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SmtpPortBox" Header="port" InputScope="Number" TextChanged="Server_Changed"/>
                        <ComboBox x:Name="SmtpSecBox" Grid.Column="1" Header="security" Margin="12,0,0,0" SelectionChanged="Sec_Changed"/>
                    </Grid>
                    <TextBlock x:Name="PinsText" Style="{StaticResource RbSmall}" Margin="0,9.5,0,0" Visibility="Collapsed"/>
                    <Button x:Name="ForgetPinsButton" Content="forget trusted certificates" Style="{StaticResource RbButton}"
                            Visibility="Collapsed" Click="ForgetPinsButton_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:RbPage>
