<local:RbPage
    x:Class="Retrobird.ProviderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Retrobird">
    <!-- Adding an account, step one (and the first page a new user sees): pick the mail service. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Style="{StaticResource RbHeaderPanel}">
            <TextBlock Text="RETROBIRD" Style="{StaticResource RbAppTitle}"/>
            <TextBlock Text="add an account" Style="{StaticResource RbPageTitle}"/>
        </StackPanel>
        <ListView x:Name="Items" Grid.Row="1" Padding="19,0,19,0" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="Items_ItemClick" ItemContainerStyle="{StaticResource RbStretchItem}">
            <ListView.Header>
                <TextBlock x:Name="IntroText" Style="{StaticResource RbSubtle}" Margin="0,0,0,19"
                           Text="Choose your mail service. Retrobird talks to it directly from your phone, with modern encryption."/>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,16" Opacity="{Binding ItemOpacity}">
                        <TextBlock Text="{Binding ShortName}" Style="{StaticResource RbItemTitleLarge}"/>
                        <TextBlock Text="{Binding Blurb}" Style="{StaticResource RbSubtle}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" Margin="0,-3,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</local:RbPage>
