<phone:PhoneApplicationPage
    x:Class="Retrobird.ProviderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:local="clr-namespace:Retrobird"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="12,8,12,8">
            <TextBlock Text="RETROBIRD" Style="{StaticResource PhoneTextNormalStyle}" Margin="12,0"/>
            <TextBlock Text="add account" Margin="9,-7,12,0" Style="{StaticResource PhoneTextTitle1Style}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="12,0,12,0">
            <StackPanel>
                <TextBlock Text="Pick your mail service." Style="{StaticResource PhoneTextSubtleStyle}" Margin="12,0,12,12"/>
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="12,0,12,18" Background="Transparent" Opacity="{Binding ItemOpacity}"
                                        Tap="Provider_Tap" Tag="{Binding}" local:Motion.Tilt="True">
                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource PhoneFontSizeExtraLarge}"
                                           FontFamily="{StaticResource PhoneFontFamilySemiLight}"/>
                                <TextBlock Text="{Binding Hint}" TextTrimming="WordEllipsis" Margin="0,-4,0,0"
                                           Foreground="{StaticResource PhoneSubtleBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Margin="12,0,12,18" Background="Transparent" Tap="Other_Tap" local:Motion.Tilt="True">
                    <TextBlock Text="other mail service" FontSize="{StaticResource PhoneFontSizeExtraLarge}"
                               FontFamily="{StaticResource PhoneFontFamilySemiLight}"/>
                    <TextBlock Text="any service with IMAP and SMTP" Margin="0,-4,0,0" Foreground="{StaticResource PhoneSubtleBrush}"/>
                </StackPanel>
                <Rectangle Height="24"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</phone:PhoneApplicationPage>
