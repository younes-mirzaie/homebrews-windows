<phone:PhoneApplicationPage
    x:Class="Retrobird.ComposePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:local="clr-namespace:Retrobird"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="PortraitOrLandscape" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="12,8,12,0">
            <TextBlock x:Name="FromText" Text="NEW MESSAGE" Style="{StaticResource PhoneTextNormalStyle}" Margin="12,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="12,0,12,0">
            <StackPanel>
                <TextBlock Text="to" Style="{StaticResource PhoneTextSubtleStyle}"/>
                <TextBox x:Name="ToBox" InputScope="EmailSmtpAddress" TextWrapping="Wrap"/>
                <StackPanel x:Name="CcPanel" Visibility="Collapsed">
                    <TextBlock Text="cc" Style="{StaticResource PhoneTextSubtleStyle}"/>
                    <TextBox x:Name="CcBox" InputScope="EmailSmtpAddress" TextWrapping="Wrap"/>
                    <TextBlock Text="bcc" Style="{StaticResource PhoneTextSubtleStyle}"/>
                    <TextBox x:Name="BccBox" InputScope="EmailSmtpAddress" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Text="subject" Style="{StaticResource PhoneTextSubtleStyle}"/>
                <TextBox x:Name="SubjectBox" InputScope="Chat"/>
                <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="300" InputScope="Chat"/>
                <TextBlock Height="96"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</phone:PhoneApplicationPage>
