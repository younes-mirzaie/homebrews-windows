<local:RbPage
    x:Class="Retrobird.ComposePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Retrobird">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Style="{StaticResource RbHeaderPanel}">
            <TextBlock x:Name="FromText" Text="NEW MESSAGE" Style="{StaticResource RbAppTitle}" Margin="0,12,0,9.5"
                       Tapped="FromText_Tapped"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="19,0,19,19">
                <TextBox x:Name="ToBox" Header="to" TextWrapping="Wrap"/>
                <StackPanel x:Name="CcPanel" Visibility="Collapsed">
                    <TextBox x:Name="CcBox" Header="cc" TextWrapping="Wrap"/>
                    <TextBox x:Name="BccBox" Header="bcc" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBox x:Name="SubjectBox" Header="subject"/>
                <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="240"
                         PlaceholderText="message"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:RbPage>
