<local:RbPage
    x:Class="Retrobird.MessagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Retrobird">
    <!-- One message: subject, sender, when and to whom (tap for every address), attachments, then
         the body. A page of its own on a phone, the right-hand pane of the inbox on wider windows.
         Code: ..\..\app\Retrobird\MessagePage.xaml.cs, shared with the phone app. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Visibility="Collapsed" Text="Message" />
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="12,12,12,0">
                <TextBlock x:Name="WhereText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock x:Name="SubjectText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" MaxHeight="84"
                           Margin="0,2,0,0" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="FromText" Style="{StaticResource BaseTextBlockStyle}" Margin="0,8,0,0"
                           Foreground="{ThemeResource SystemControlForegroundAccentBrush}" TextTrimming="CharacterEllipsis" />
                <!-- tap for every address -->
                <TextBlock x:Name="WhenText" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,2,0,0" Tapped="Header_Tapped"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailsText" Visibility="Collapsed" Margin="0,6,0,0" Style="{StaticResource RbSmall}"
                           IsTextSelectionEnabled="True" />
                <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="0,12,0,0" Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <!-- attachments: a short list with a paper clip each -->
                <ListView x:Name="Attachments" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Attachments_ItemClick" MaxHeight="136" ItemContainerStyle="{StaticResource MailItemContainer}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,4" MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE723;" FontSize="16" Foreground="White" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- remote pictures are blocked until asked for -->
                <Grid x:Name="PicturesBand" Visibility="Collapsed" Margin="12,4,12,4" Padding="12,4"
                      Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Pictures from the web are hidden to protect your privacy." Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                    <HyperlinkButton Grid.Column="1" Content="Show pictures" Margin="12,0,0,0" Click="ImagesButton_Click" />
                </Grid>
            </StackPanel>
            <!-- the mail engine has already removed scripts and blocked remote pictures from the HTML -->
            <WebView x:Name="Body" Grid.Row="2" Opacity="0" Margin="0,8,0,0"
                     NavigationStarting="Body_NavigationStarting" NavigationCompleted="Body_NavigationCompleted" />
        </Grid>
        <CommandBar x:Name="Bar" Grid.Row="2" />
    </Grid>
</local:RbPage>
