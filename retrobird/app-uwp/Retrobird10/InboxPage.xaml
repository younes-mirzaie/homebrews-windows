<local:RbPage
    x:Class="Retrobird.InboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Retrobird"
    NavigationCacheMode="Required">
    <!-- The inbox: a pivot of all, unread and flagged mail, grouped by day. From 720 px the open
         message sits on the right (master/details); below that it opens as its own page. -->
    <local:RbPage.Resources>
        <CollectionViewSource x:Key="AllSource" IsSourceGrouped="True" />
        <CollectionViewSource x:Key="UnreadSource" IsSourceGrouped="True" />
        <CollectionViewSource x:Key="FlaggedSource" IsSourceGrouped="True" />
    </local:RbPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Visibility="Collapsed" Text="Inbox" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="*" />
                <ColumnDefinition x:Name="DetailsColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Pivot x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                    <PivotItem Header="All" Margin="0">
                        <Grid>
                            <ListView x:Name="AllList" ItemsSource="{Binding Source={StaticResource AllSource}}"
                                      ItemTemplate="{StaticResource MailItem}" ItemContainerStyle="{StaticResource MailItemContainer}"
                                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="List_ItemClick"
                                      SelectionChanged="List_SelectionChanged">
                                <ListView.GroupStyle>
                                    <GroupStyle HidesIfEmpty="True" HeaderTemplate="{StaticResource DayHeader}" />
                                </ListView.GroupStyle>
                                <ListView.Footer>
                                    <Button x:Name="MoreButton" Content="Load older messages" Margin="12,12,12,24"
                                            Click="MoreButton_Click" Visibility="Collapsed" />
                                </ListView.Footer>
                            </ListView>
                            <TextBlock x:Name="AllEmpty" Text="No mail here." Visibility="Collapsed" Margin="12,16,12,0"
                                       Style="{StaticResource EmptyText}" />
                        </Grid>
                    </PivotItem>
                    <PivotItem Header="Unread" Margin="0">
                        <Grid>
                            <ListView x:Name="UnreadList" ItemsSource="{Binding Source={StaticResource UnreadSource}}"
                                      ItemTemplate="{StaticResource MailItem}" ItemContainerStyle="{StaticResource MailItemContainer}"
                                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="List_ItemClick"
                                      SelectionChanged="List_SelectionChanged">
                                <ListView.GroupStyle>
                                    <GroupStyle HidesIfEmpty="True" HeaderTemplate="{StaticResource DayHeader}" />
                                </ListView.GroupStyle>
                            </ListView>
                            <TextBlock x:Name="UnreadEmpty" Text="You're all caught up." Visibility="Collapsed" Margin="12,16,12,0"
                                       Style="{StaticResource EmptyText}" />
                        </Grid>
                    </PivotItem>
                    <PivotItem Header="Flagged" Margin="0">
                        <Grid>
                            <ListView x:Name="FlaggedList" ItemsSource="{Binding Source={StaticResource FlaggedSource}}"
                                      ItemTemplate="{StaticResource MailItem}" ItemContainerStyle="{StaticResource MailItemContainer}"
                                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="List_ItemClick"
                                      SelectionChanged="List_SelectionChanged">
                                <ListView.GroupStyle>
                                    <GroupStyle HidesIfEmpty="True" HeaderTemplate="{StaticResource DayHeader}" />
                                </ListView.GroupStyle>
                            </ListView>
                            <TextBlock x:Name="FlaggedEmpty" Text="Flag mail to keep it here." Visibility="Collapsed" Margin="12,16,12,0"
                                       Style="{StaticResource EmptyText}" />
                        </Grid>
                    </PivotItem>
                </Pivot>

                <!-- the engine couldn't start: say so plainly, with a way to try again -->
                <StackPanel x:Name="ProblemPanel" Margin="12,96,12,0" Visibility="Collapsed"
                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <TextBlock x:Name="ProblemText" Style="{StaticResource BodyTextBlockStyle}" />
                    <Button Content="Try again" Margin="0,12,0,0" Click="RetryButton_Click" />
                </StackPanel>

                <!-- a problem with an account or the connection; tap it to fix -->
                <Border x:Name="StatusBand" Grid.Row="1" Visibility="Collapsed" Tapped="StatusBand_Tapped"
                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                    <Grid Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE7BA;" FontSize="16" Margin="0,2,12,0"
                                  VerticalAlignment="Top" />
                        <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>

            <!-- the open message (wide windows only) -->
            <Border x:Name="DetailsPane" Grid.Column="1" BorderThickness="1,0,0,0"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                <Grid>
                    <TextBlock x:Name="NothingOpen" Text="Choose a message to read it here." Margin="24,24,24,0"
                               Style="{StaticResource EmptyText}" />
                    <Frame x:Name="DetailsFrame" Tag="details">
                        <Frame.ContentTransitions>
                            <TransitionCollection>
                                <NavigationThemeTransition>
                                    <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                        <EntranceNavigationTransitionInfo />
                                    </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                </NavigationThemeTransition>
                            </TransitionCollection>
                        </Frame.ContentTransitions>
                    </Frame>
                </Grid>
            </Border>
        </Grid>

        <CommandBar x:Name="Bar" Grid.Row="2" />
    </Grid>
</local:RbPage>
