<phone:PhoneApplicationPage
    x:Class="RetroFiles.PropertiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="PortraitOrLandscape" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">
    <ScrollViewer>
        <StackPanel Margin="24,8,24,24">
            <TextBlock Text="PROPERTIES" Style="{StaticResource PhoneTextNormalStyle}" Margin="0"/>
            <TextBlock x:Name="NameText" FontSize="{StaticResource PhoneFontSizeExtraLarge}" FontFamily="{StaticResource PhoneFontFamilySemiLight}" TextWrapping="Wrap"/>
            <TextBlock x:Name="InfoText" TextWrapping="Wrap" Margin="0,12,0,12" Foreground="{StaticResource PhoneSubtleBrush}"/>
            <TextBlock Text="attributes" Style="{StaticResource PhoneTextLargeStyle}" Margin="0,12,0,0"/>
            <CheckBox x:Name="ReadOnlyBox" Content="read-only"/>
            <CheckBox x:Name="HiddenBox" Content="hidden"/>
            <CheckBox x:Name="SystemBox" Content="system"/>
            <CheckBox x:Name="ArchiveBox" Content="archive"/>
            <TextBlock x:Name="OtherAttrs" TextWrapping="Wrap" Foreground="{StaticResource PhoneSubtleBrush}"/>
            <Button x:Name="ApplyButton" Content="apply attributes" Click="Apply_Click" HorizontalAlignment="Left"/>
            <Button x:Name="SizeButton" Content="calculate folder size" Click="Size_Click" HorizontalAlignment="Left" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</phone:PhoneApplicationPage>
