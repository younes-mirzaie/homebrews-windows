<Page
    x:Class="Unesbrews.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Unesbrews"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- The app's frame: a 48 px top bar with the hamburger button and the page title, a status row
         while something runs, and a SplitView navigation pane (overlay on phones, a 48 px rail from
         641 px, docked open from 1008 px). Pages load into ContentFrame. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidth">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Nav.DisplayMode" Value="CompactOverlay" />
                        <Setter Target="Nav.OpenPaneLength" Value="320" />
                        <Setter Target="PageTitle.Margin" Value="12,0,24,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Nav.DisplayMode" Value="CompactInline" />
                        <Setter Target="Nav.IsPaneOpen" Value="True" />
                        <Setter Target="Nav.OpenPaneLength" Value="320" />
                        <Setter Target="PageTitle.Margin" Value="12,0,24,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- top bar -->
        <Grid Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="Hamburger" Width="48" Height="48" Padding="0" Background="Transparent" BorderThickness="0"
                    Click="Hamburger_Click" AutomationProperties.Name="Navigation"
                    ToolTipService.ToolTip="Navigation">
                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE700;" FontSize="20" />
            </Button>
            <TextBlock x:Name="PageTitle" Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center"
                       Style="{StaticResource BaseTextBlockStyle}" FontWeight="Bold" CharacterSpacing="75"
                       TextTrimming="CharacterEllipsis" Text="CATALOG" />
        </Grid>

        <!-- what's running: an indeterminate bar and one line of text -->
        <StackPanel x:Name="StatusRow" Grid.Row="1" Visibility="Collapsed"
                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <ProgressBar IsIndeterminate="True" Height="4" />
            <TextBlock x:Name="StatusText" Margin="12,4,12,8" Style="{StaticResource CaptionTextBlockStyle}"
                       TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

        <SplitView x:Name="Nav" Grid.Row="2" DisplayMode="Overlay" OpenPaneLength="256" CompactPaneLength="48"
                   PaneBackground="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <SplitView.Pane>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="TopItems" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="NavItem_Click"
                              ItemContainerStyle="{StaticResource NavItem}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:NavEntry">
                                <Grid Height="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="{x:Bind Glyph}" FontSize="20" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Label}" VerticalAlignment="Center"
                                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Count, Mode=OneWay}" Margin="8,0,12,0" VerticalAlignment="Center"
                                               Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ListView x:Name="BottomItems" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="NavItem_Click"
                              ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:NavEntry">
                                <Grid Height="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="{x:Bind Glyph}" FontSize="20" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Label}" VerticalAlignment="Center"
                                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="NoWrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </SplitView.Pane>
            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </SplitView>
    </Grid>
</Page>
