<Page
    x:Class="Unesbrews.Pages.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The technical details behind the plain messages (installer output, error codes), newest first. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Wider">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="641" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Bar.(Grid.Row)" Value="0" />
                        <Setter Target="LogText.Margin" Value="24,12,24,24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="LogText" Margin="12,12,12,24" Style="{StaticResource BodyTextBlockStyle}"
                       IsTextSelectionEnabled="True" MaxWidth="720" HorizontalAlignment="Left" />
        </ScrollViewer>

        <CommandBar x:Name="Bar" Grid.Row="2">
            <AppBarButton Label="Copy" Click="Copy_Click">
                <AppBarButton.Icon><FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE8C8;" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
    </Grid>
</Page>
