<Page
    x:Class="Unesbrews.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Settings, Windows 10 style: toggle switches with a line of explanation each, then links to
         the activity log and About. -->
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Wider">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="641" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Body.Margin" Value="24,16,24,24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Margin="12,16,12,24" MaxWidth="720" HorizontalAlignment="Left">

                <ToggleSwitch x:Name="NotificationsSwitch" Header="Notifications" Toggled="Notifications_Toggled" />
                <TextBlock Style="{StaticResource NoteText}" Margin="0,0,0,24"
                           Text="Download progress, whether an install worked (and why not, if it didn't), and updates that are ready." />

                <ToggleSwitch x:Name="AutoUpdatesSwitch" Header="Automatic updates" Toggled="AutoUpdates_Toggled" />
                <TextBlock x:Name="AutoUpdatesNote" Style="{StaticResource NoteText}" Margin="0,0,0,24" />

                <TextBlock Text="More" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,4" />
                <HyperlinkButton Content="Activity log" Click="Log_Click" />
                <HyperlinkButton Content="About Unesbrews" Click="About_Click" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
