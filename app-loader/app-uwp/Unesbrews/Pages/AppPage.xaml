<Page
    x:Class="Unesbrews.Pages.AppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Unesbrews.Pages">

    <!-- One catalog app, like a Store product page: icon and name, the main action (install,
         update or reinstall) as an accent button, description, details and every version. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Wider">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="641" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Bar.(Grid.Row)" Value="0" />
                        <Setter Target="Body.Margin" Value="24,16,24,24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Margin="12,16,12,24" MaxWidth="720" HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="96" Height="96" VerticalAlignment="Top" Background="{ThemeResource SystemControlBackgroundAccentBrush}">
                        <TextBlock x:Name="AppLetter" Foreground="White" FontSize="46" FontWeight="Light"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="AppIcon" Stretch="UniformToFill" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                        <TextBlock x:Name="AppName" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="AppBy" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock x:Name="StateLine" Style="{StaticResource BodyTextBlockStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Button x:Name="MainAction" Style="{StaticResource PrimaryAction}" Margin="0,24,0,0" Click="MainAction_Click" />

                <TextBlock x:Name="Description" Style="{StaticResource BodyTextBlockStyle}" Margin="0,24,0,0" />

                <TextBlock Text="Details" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,32,0,8" />
                <TextBlock x:Name="Details" Style="{StaticResource NoteText}" IsTextSelectionEnabled="True" />
                <HyperlinkButton x:Name="SourceLink" Content="Source code" Visibility="Collapsed" Margin="0,8,0,0" />

                <TextBlock Text="Versions" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,32,0,4" />
                <TextBlock Style="{StaticResource NoteText}" Margin="0,0,0,8"
                           Text="Tap a version to install that one. The phone may refuse to go back to an older version." />
                <ListView x:Name="Versions" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Versions_ItemClick"
                          ScrollViewer.VerticalScrollMode="Disabled" Margin="-12,0,-12,0" Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:VersionRow">
                            <StackPanel Padding="0,10,0,12">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BaseTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource NoteText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <CommandBar x:Name="Bar" Grid.Row="2">
            <AppBarButton x:Name="SaveButton" Label="Download package" Click="Save_Click">
                <AppBarButton.Icon><FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE896;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="OpenButton" Label="Open" Click="Open_Click" IsEnabled="False">
                <AppBarButton.Icon><FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE8A7;" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
    </Grid>
</Page>
