<Page
    x:Class="Unesbrews.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Wider">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="641" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Body.Margin" Value="24,16,24,24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Body" Margin="12,16,12,24" MaxWidth="720" HorizontalAlignment="Left">

            <Image Source="ms-appx:///Assets/Square150x150Logo.png" Width="96" Height="96" HorizontalAlignment="Left" />
            <TextBlock Text="Unesbrews" Style="{StaticResource TitleTextBlockStyle}" Margin="0,16,0,0" />
            <TextBlock x:Name="VersionText" Style="{StaticResource NoteText}" Margin="0,4,0,0" />
            <TextBlock Text="Homebrew apps by Younes" Style="{StaticResource BodyTextBlockStyle}" Margin="0,16,0,0" />

            <TextBlock Text="What it needs" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,32,0,8" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}">
                Unesbrews installs apps with the phone's own installer, through the system shell that CMD Injector sets up. So the phone has to be unlocked with CMD Injector.
                <LineBreak /><LineBreak />
                The first time, allow Unesbrews to reach that shell: open CMD Injector, go to the app manager, pick Unesbrews and tap Enable Loopback.
            </TextBlock>

            <TextBlock Text="How it installs" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,32,0,8" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}">
                Apps you already have are updated in place and keep their data. Nothing is ever uninstalled.
                Downloads from the catalog are checked against its signed list before anything is installed.
                Installs carry on when you leave the app or lock the phone.
            </TextBlock>

            <TextBlock Text="Windows Phone 8.1" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,32,0,8" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}">
                This is the Windows 10 version. Phones on Windows Phone 8.1 keep the 8.1 version of Unesbrews, which does the same things. If the 8.1 version is also on this phone, you can uninstall it whenever you like.
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
